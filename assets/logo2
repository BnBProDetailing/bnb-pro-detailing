<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>B&B Auto Detail Logo</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #050505;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            font-family: 'Times New Roman', Times, serif;
        }

        .logo-container {
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            background: radial-gradient(circle at center, #111a2e 0%, #050505 75%);
            padding: 50px;
            border-radius: 20px;
        }

        /* SVG Styling for the metallic and gloss effects */
        svg {
            width: 340px;
            height: auto;
            filter: drop-shadow(0px 15px 25px rgba(0, 0, 0, 0.85));
        }

        .text-main {
            font-family: 'Cinzel', 'Times New Roman', serif;
            font-size: 34px;
            letter-spacing: 6px;
            fill: url(#gold-gradient);
            text-anchor: middle;
            font-weight: bold;
            filter: drop-shadow(2px 2px 4px rgba(0,0,0,0.6));
        }

        .text-sub {
            font-family: 'Georgia', serif;
            font-size: 15px;
            font-style: italic;
            letter-spacing: 4px;
            fill: url(#gold-light-gradient);
            text-anchor: middle;
            opacity: 0.75;
        }
    </style>
</head>
<body>

    <div class="logo-container">
        <svg viewBox="0 0 400 450" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <!-- Metallic Shield Outer Chrome Edge Gradient -->
                <linearGradient id="metal-edge" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#f5f5f5" />
                    <stop offset="25%" stop-color="#8a939e" />
                    <stop offset="50%" stop-color="#ffffff" />
                    <stop offset="75%" stop-color="#4a5056" />
                    <stop offset="100%" stop-color="#d6dadf" />
                </linearGradient>

                <!-- Beveled Dark Steel Background Gradient -->
                <linearGradient id="metal-dark" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="#5c6470" />
                    <stop offset="100%" stop-color="#111416" />
                </linearGradient>

                <!-- Deep Blue Gloss Shield Internal Fill -->
                <radialGradient id="blue-shield" cx="50%" cy="40%" r="65%">
                    <stop offset="0%" stop-color="#1b3561" />
                    <stop offset="60%" stop-color="#0a1424" />
                    <stop offset="100%" stop-color="#03060c" />
                </radialGradient>

                <!-- 3D Luxury Gold Text Gradient -->
                <linearGradient id="gold-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#f3dfa2" />
                    <stop offset="30%" stop-color="#c9a75f" />
                    <stop offset="50%" stop-color="#fff8db" />
                    <stop offset="70%" stop-color="#b88f3c" />
                    <stop offset="100%" stop-color="#8f6922" />
                </linearGradient>

                <linearGradient id="gold-light-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#b88f3c" />
                    <stop offset="50%" stop-color="#fff8db" />
                    <stop offset="100%" stop-color="#b88f3c" />
                </linearGradient>

                <!-- Metallic Blue Car Silhouette Body Gradient -->
                <linearGradient id="car-body" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#071121" />
                    <stop offset="25%" stop-color="#16315c" />
                    <stop offset="50%" stop-color="#3d72b5" />
                    <stop offset="75%" stop-color="#16315c" />
                    <stop offset="100%" stop-color="#071121" />
                </linearGradient>
            </defs>

            <!-- Outer Shield Rim Structure -->
            <path d="M 60 100 L 200 40 L 340 100 L 320 260 L 200 355 L 80 260 Z" fill="url(#metal-dark)" stroke="url(#metal-edge)" stroke-width="5" stroke-linejoin="round"/>
            
            <!-- Inner Dark Crest Inset -->
            <path d="M 70 108 L 200 52 L 330 108 L 312 252 L 200 342 L 88 252 Z" fill="url(#blue-shield)" stroke="url(#metal-edge)" stroke-width="2.5" stroke-linejoin="round"/>
            
            <!-- Subtle Radial Inner Border Trim -->
            <path d="M 82 118 L 200 66 L 318 118 L 302 244 L 200 328 L 98 244 Z" fill="none" stroke="#284e88" stroke-width="1.5" opacity="0.6"/>

            <!-- Serif Gold B&B Inscription Inside Shield -->
            <text x="200" y="152" font-family="'Cinzel', 'Times New Roman', serif" font-size="54" font-weight="bold" fill="url(#gold-gradient)" text-anchor="middle" letter-spacing="2" filter="drop-shadow(0px 5px 6px rgba(0,0,0,0.75))">B&B</text>

            <!-- Aerodynamic Performance Sports Car Overlay Vector Details -->
            <g transform="translate(0, 12)">
                <!-- Dark Background Shadow Projection Below Vehicle -->
                <path d="M 120 220 Q 200 224 280 220 Q 325 225 350 240 L 355 252 Q 290 262 200 262 Q 110 262 45 252 L 50 240 Z" fill="#010307" opacity="0.9" />

                <!-- Metallic Body Silhouette Curve Mapping -->
                <path d="M 48 240 
                         C 68 224, 108 214, 138 194 
                         C 158 178, 182 163, 232 163 
                         C 272 163, 312 183, 338 208 
                         C 348 218, 358 228, 362 240 
                         C 342 251, 312 256, 282 254
                         C 272 239, 252 239, 242 254
                         C 182 256, 152 256, 132 254
                         C 122 239, 102 239, 92 254
                         C 70 254, 54 247, 48 240 Z" 
                      fill="url(#car-body)" stroke="url(#metal-edge)" stroke-width="1.5" />

                <!-- Cabin Glass Canopy Gloss Panels -->
                <path d="M 145 194 C 165 181, 185 167, 225 167 C 255 167, 290 181, 310 199 C 270 194, 200 194, 145 194 Z" fill="#ffffff" opacity="0.22" />
                <path d="M 155 192 C 175 183, 190 172, 225 172 C 250 172, 275 183, 295 195 C 260 190, 200 190, 155 192 Z" fill="#02050a" opacity="0.8" />

                <!-- Stylized Chrome Highlights and Body Crease Lines -->
                <path d="M 138 194 Q 200 209 282 211" fill="none" stroke="#7cb2f0" stroke-width="2.5" opacity="0.85"/>
                <path d="M 108 214 Q 190 224 318 217" fill="none" stroke="#ffffff" stroke-width="1.5" opacity="0.95"/>
                <path d="M 72 229 Q 150 239 348 231" fill="none" stroke="#a2cffe" stroke-width="2" opacity="0.55"/>
                
                <!-- Front End Headlight Profile Beams -->
                <path d="M 285 224 Q 325 227 354 239" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" />
                <path d="M 295 234 Q 330 237 350 246" fill="none" stroke="#3d72b5" stroke-width="1.5" />
                
                <!-- Aggressive Low-Profile Wheel Arch Concentrics -->
                <path d="M 87 254 C 87 241, 97 237, 107 242 C 112 245, 114 251, 114 254" fill="none" stroke="#6c757d" stroke-width="2" />
                <path d="M 235 254 C 235 241, 247 237, 257 242 C 262 245, 264 251, 264 254" fill="none" stroke="#6c757d" stroke-width="2" />
            </g>

            <!-- Bottom Typographical Brand Labels -->
            <text x="200" y="398" class="text-main">AUTO DETAIL</text>
            <text x="200" y="428" class="text-sub">EST. 2024</text>
        </svg>
    </div>

</body>
</html>
